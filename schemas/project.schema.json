{
  "$defs": {
    "CalcDocument": {
      "additionalProperties": false,
      "description": "Header values of a calculation sheet; ``scope`` is its scope line.",
      "properties": {
        "doc_no": {
          "title": "Doc No",
          "type": "string"
        },
        "issue_date": {
          "format": "date",
          "title": "Issue Date",
          "type": "string"
        },
        "rev": {
          "minLength": 1,
          "title": "Rev",
          "type": [
            "string",
            "integer"
          ]
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "doc_no",
        "rev",
        "issue_date",
        "scope"
      ],
      "title": "CalcDocument",
      "type": "object"
    },
    "DesignConstants": {
      "additionalProperties": false,
      "description": "Calculation constants with the spec's defaults (Inputs, 3. Project settings).",
      "properties": {
        "ac_voltage_v": {
          "default": 230,
          "exclusiveMinimum": 0,
          "title": "Ac Voltage V",
          "type": "number"
        },
        "air_constant_m3k_per_wh": {
          "default": 4.1,
          "exclusiveMinimum": 0,
          "title": "Air Constant M3K Per Wh",
          "type": "number"
        },
        "btu_per_w": {
          "default": 3.41,
          "exclusiveMinimum": 0,
          "title": "Btu Per W",
          "type": "number"
        },
        "current_factor": {
          "default": 1.3,
          "exclusiveMinimum": 0,
          "title": "Current Factor",
          "type": "number"
        },
        "dc_voltage_v": {
          "default": 125,
          "exclusiveMinimum": 0,
          "title": "Dc Voltage V",
          "type": "number"
        },
        "min_main_mcb_a": {
          "default": 6,
          "exclusiveMinimum": 0,
          "title": "Min Main Mcb A",
          "type": "integer"
        },
        "power_margin": {
          "default": 0.25,
          "minimum": 0,
          "title": "Power Margin",
          "type": "number"
        },
        "steel_coefficient_w_per_m2c": {
          "default": 5.5,
          "exclusiveMinimum": 0,
          "title": "Steel Coefficient W Per M2C",
          "type": "number"
        },
        "t_int_c": {
          "default": 25,
          "title": "T Int C",
          "type": "number"
        },
        "t_max_c": {
          "default": 35,
          "title": "T Max C",
          "type": "number"
        }
      },
      "title": "DesignConstants",
      "type": "object"
    },
    "Documents": {
      "additionalProperties": false,
      "properties": {
        "heat_calculations": {
          "$ref": "#/$defs/CalcDocument"
        },
        "heat_dissipation": {
          "$ref": "#/$defs/CalcDocument"
        },
        "power_consumption": {
          "$ref": "#/$defs/CalcDocument"
        }
      },
      "required": [
        "power_consumption",
        "heat_dissipation",
        "heat_calculations"
      ],
      "title": "Documents",
      "type": "object"
    },
    "LooseExtra": {
      "additionalProperties": false,
      "description": "A loose-material row, optionally with kit children and a feeding panel.",
      "properties": {
        "children": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        },
        "fed_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fed From"
        },
        "part_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "title": "Part Id",
          "type": "string"
        },
        "qty": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "const": "1 Lot"
            }
          ],
          "default": 1,
          "title": "Qty"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        }
      },
      "required": [
        "part_id"
      ],
      "title": "LooseExtra",
      "type": "object"
    },
    "LooseMaterial": {
      "additionalProperties": false,
      "properties": {
        "host_panel": {
          "title": "Host Panel",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LooseExtra"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "host_panel"
      ],
      "title": "LooseMaterial",
      "type": "object"
    },
    "OutputSettings": {
      "additionalProperties": false,
      "description": "Workbook file name template and calculation sheet names.",
      "properties": {
        "file_name": {
          "default": "{doc_no}_PSA_BOM_Rev{rev}.xlsx",
          "title": "File Name",
          "type": "string"
        },
        "sheet_names": {
          "$ref": "#/$defs/SheetNames"
        }
      },
      "title": "OutputSettings",
      "type": "object"
    },
    "ProjectInfo": {
      "additionalProperties": false,
      "properties": {
        "doc_no": {
          "title": "Doc No",
          "type": "string"
        },
        "logo": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rev": {
          "default": "0",
          "minLength": 1,
          "title": "Rev",
          "type": [
            "string",
            "integer"
          ]
        },
        "substation": {
          "title": "Substation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "substation",
        "doc_no"
      ],
      "title": "ProjectInfo",
      "type": "object"
    },
    "SheetNames": {
      "additionalProperties": false,
      "properties": {
        "heat_calculations": {
          "default": "Heat Calculations",
          "maxLength": 31,
          "minLength": 1,
          "pattern": "^(?!')(?:[^\\[\\]:*?/\\\\']|'(?!$))*$",
          "title": "Heat Calculations",
          "type": [
            "string",
            "integer"
          ]
        },
        "heat_dissipation": {
          "default": "Heat Dissipation",
          "maxLength": 31,
          "minLength": 1,
          "pattern": "^(?!')(?:[^\\[\\]:*?/\\\\']|'(?!$))*$",
          "title": "Heat Dissipation",
          "type": [
            "string",
            "integer"
          ]
        },
        "power_consumption": {
          "default": "Power Consumption",
          "maxLength": 31,
          "minLength": 1,
          "pattern": "^(?!')(?:[^\\[\\]:*?/\\\\']|'(?!$))*$",
          "title": "Power Consumption",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "SheetNames",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The project file (``project.yaml``).",
  "properties": {
    "constants": {
      "$ref": "#/$defs/DesignConstants"
    },
    "documents": {
      "$ref": "#/$defs/Documents"
    },
    "library": {
      "format": "path",
      "title": "Library",
      "type": "string"
    },
    "loose_material": {
      "anyOf": [
        {
          "$ref": "#/$defs/LooseMaterial"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output": {
      "$ref": "#/$defs/OutputSettings"
    },
    "panels": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "minItems": 1,
      "title": "Panels",
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectInfo"
    }
  },
  "required": [
    "project",
    "library",
    "panels",
    "documents"
  ],
  "title": "Project",
  "type": "object"
}
