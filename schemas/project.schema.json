{
  "$defs": {
    "CatalogueChoice": {
      "additionalProperties": false,
      "description": "The brand set picked per catalogue; unset means ``default``.",
      "properties": {
        "aux_contact": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aux Contact"
        },
        "busbars": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Busbars"
        },
        "housekeeping": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Housekeeping"
        },
        "mcb": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcb"
        },
        "terminal_blocks": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminal Blocks"
        }
      },
      "title": "CatalogueChoice",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "Values every substation inherits key by key.",
      "properties": {
        "catalogue_choice": {
          "$ref": "#/$defs/CatalogueChoice"
        },
        "constants": {
          "$ref": "#/$defs/DesignConstants"
        },
        "spares": {
          "$ref": "#/$defs/Spares"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "DesignConstants": {
      "additionalProperties": false,
      "description": "Calculation constants with the spec's defaults (Inputs, 3. Project settings).",
      "properties": {
        "ac_voltage_v": {
          "default": 230,
          "exclusiveMinimum": 0,
          "title": "Ac Voltage V",
          "type": "number"
        },
        "air_constant_m3k_per_wh": {
          "default": 4.1,
          "exclusiveMinimum": 0,
          "title": "Air Constant M3K Per Wh",
          "type": "number"
        },
        "btu_per_w": {
          "default": 3.41,
          "exclusiveMinimum": 0,
          "title": "Btu Per W",
          "type": "number"
        },
        "current_factor": {
          "default": 1.3,
          "exclusiveMinimum": 0,
          "title": "Current Factor",
          "type": "number"
        },
        "dc_voltage_v": {
          "default": 125,
          "exclusiveMinimum": 0,
          "title": "Dc Voltage V",
          "type": "number"
        },
        "inrush_min_ms": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Inrush Min Ms",
          "type": "number"
        },
        "min_branch_mcb_a": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Min Branch Mcb A",
          "type": "integer"
        },
        "min_main_mcb_a": {
          "default": 6,
          "exclusiveMinimum": 0,
          "title": "Min Main Mcb A",
          "type": "integer"
        },
        "power_margin": {
          "default": 0.25,
          "minimum": 0,
          "title": "Power Margin",
          "type": "number"
        },
        "steel_coefficient_w_per_m2c": {
          "default": 5.5,
          "exclusiveMinimum": 0,
          "title": "Steel Coefficient W Per M2C",
          "type": "number"
        },
        "t_int_c": {
          "default": 25,
          "title": "T Int C",
          "type": "number"
        },
        "t_max_c": {
          "default": 35,
          "title": "T Max C",
          "type": "number"
        }
      },
      "title": "DesignConstants",
      "type": "object"
    },
    "LibrarySelection": {
      "additionalProperties": false,
      "description": "The installed library every substation uses; ``file`` loads one from disk instead.",
      "properties": {
        "file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\+local\\.[1-9][0-9]*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "LibrarySelection",
      "type": "object"
    },
    "ProjectInfo": {
      "additionalProperties": false,
      "properties": {
        "client": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "logo": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectInfo",
      "type": "object"
    },
    "RegisterEntry": {
      "additionalProperties": false,
      "description": "One document of the project's register; ``key`` is what panels and sheets name.",
      "properties": {
        "doc_no": {
          "title": "Doc No",
          "type": "string"
        },
        "issue_date": {
          "format": "date",
          "title": "Issue Date",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Key",
          "type": "string"
        },
        "rev": {
          "minLength": 1,
          "title": "Rev",
          "type": [
            "string",
            "integer"
          ]
        },
        "substation": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Substation",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "doc_no",
        "rev",
        "issue_date",
        "key",
        "substation"
      ],
      "title": "RegisterEntry",
      "type": "object"
    },
    "Spares": {
      "additionalProperties": false,
      "description": "Every spare as a user input, defaults as today (ADR 0013).",
      "properties": {
        "ac_branches": {
          "default": 1,
          "minimum": 0,
          "title": "Ac Branches",
          "type": "integer"
        },
        "dc_branches_per_feed": {
          "default": 3,
          "minimum": 0,
          "title": "Dc Branches Per Feed",
          "type": "integer"
        },
        "port_fraction": {
          "default": 0.2,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Port Fraction",
          "type": "number"
        },
        "rack_u_reserved": {
          "default": 10,
          "minimum": 0,
          "title": "Rack U Reserved",
          "type": "integer"
        },
        "sfp_per_l1": {
          "default": 3,
          "minimum": 0,
          "title": "Sfp Per L1",
          "type": "integer"
        }
      },
      "title": "Spares",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The project file (``project.yaml``).",
  "properties": {
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/RegisterEntry"
      },
      "title": "Documents",
      "type": "array"
    },
    "library": {
      "$ref": "#/$defs/LibrarySelection"
    },
    "project": {
      "$ref": "#/$defs/ProjectInfo"
    },
    "substations": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "minItems": 1,
      "title": "Substations",
      "type": "array"
    }
  },
  "required": [
    "project",
    "library",
    "substations"
  ],
  "title": "Project",
  "type": "object"
}
