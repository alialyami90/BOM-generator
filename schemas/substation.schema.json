      "type": "string"
    },
    "equipment": {
      "items": {
        "$ref": "#/$defs/Equipment"
      },
      "title": "Equipment",
      "type": "array"
    },
    "generated_panels": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratedPanels"
        },
        {
