{
  "$description": "bomgen desktop app design tokens (W3C Design Tokens format). Platform-neutral. 'primitive' holds raw values; 'semantic.light' and 'semantic.dark' map roles to primitives and are what components use. Regenerate prototype/tokens.css with `node tools/build-tokens.mjs`.",
  "primitive": {
    "color": {
      "navy": {
        "950": { "$type": "color", "$value": "#05273F" },
        "900": { "$type": "color", "$value": "#003B5D", "$description": "Top bar, footer, headings. Sampled from the reference screenshots." },
        "800": { "$type": "color", "$value": "#124F75" },
        "700": { "$type": "color", "$value": "#2B6489" }
      },
      "cobalt": {
        "800": { "$type": "color", "$value": "#1431A8" },
        "700": { "$type": "color", "$value": "#1A3FD8", "$description": "Primary action, links, focus. Sampled from the reference screenshots." },
        "500": { "$type": "color", "$value": "#3D5CF0" },
        "300": { "$type": "color", "$value": "#8FA8FF" },
        "100": { "$type": "color", "$value": "#E3E9FB" },
        "50":  { "$type": "color", "$value": "#EFF2FD" }
      },
      "slate": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#F2F5FA", "$description": "Page ground. Sampled from the reference screenshots." },
        "100": { "$type": "color", "$value": "#E7ECF3" },
        "200": { "$type": "color", "$value": "#D5DCE6" },
        "400": { "$type": "color", "$value": "#7C8A9E" },
        "500": { "$type": "color", "$value": "#566579" },
        "700": { "$type": "color", "$value": "#34465B" },
        "900": { "$type": "color", "$value": "#14263A" }
      },
      "night": {
        "950": { "$type": "color", "$value": "#0A1521" },
        "900": { "$type": "color", "$value": "#0E1B29" },
        "800": { "$type": "color", "$value": "#14263A" },
        "700": { "$type": "color", "$value": "#1D3249" },
        "600": { "$type": "color", "$value": "#2A4059" },
        "400": { "$type": "color", "$value": "#6A7F9A" },
        "300": { "$type": "color", "$value": "#9AABC0" },
        "100": { "$type": "color", "$value": "#E6ECF4" }
      },
      "red": {
        "700": { "$type": "color", "$value": "#B00D28" },
        "600": { "$type": "color", "$value": "#C8102E" },
        "300": { "$type": "color", "$value": "#FF7A8A" },
        "100": { "$type": "color", "$value": "#FDECEF" },
        "900": { "$type": "color", "$value": "#3A1620" }
      },
      "amber": {
        "700": { "$type": "color", "$value": "#7A4F00" },
        "300": { "$type": "color", "$value": "#F2B84B" },
        "100": { "$type": "color", "$value": "#FFF3D1" },
        "900": { "$type": "color", "$value": "#34270D" }
      },
      "green": {
        "700": { "$type": "color", "$value": "#0B6B3A" },
        "300": { "$type": "color", "$value": "#5FD08F" },
        "100": { "$type": "color", "$value": "#E2F4EA" },
        "900": { "$type": "color", "$value": "#0F2C1E" }
      },
      "highlight": {
        "yellow": { "$type": "color", "$value": "#FFFF00", "$description": "Revised-cell highlight, matches the workbook (OUT-8). Used only to show what the workbook will highlight." }
      }
    },
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": ["Hanken Grotesk", "Segoe UI", "system-ui", "sans-serif"], "$description": "Bundled, SIL OFL 1.1." },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "Cascadia Mono", "Consolas", "monospace"], "$description": "Bundled, SIL OFL 1.1. Part numbers, tags, YAML, quantities." }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "bar":            { "$type": "color", "$value": "{primitive.color.navy.900}", "$description": "Top bar and footer fill." },
        "onBar":          { "$type": "color", "$value": "{primitive.color.slate.0}" },
        "onBarMuted":     { "$type": "color", "$value": "#B9CCDB" },
        "ground":         { "$type": "color", "$value": "{primitive.color.slate.50}" },
        "surface":        { "$type": "color", "$value": "{primitive.color.slate.0}" },
        "surfaceSunken":  { "$type": "color", "$value": "{primitive.color.slate.100}" },
        "surfaceBand":    { "$type": "color", "$value": "#DCE3EC", "$description": "BOM group separator rows." },
        "border":         { "$type": "color", "$value": "{primitive.color.slate.200}" },
        "borderControl":  { "$type": "color", "$value": "{primitive.color.slate.400}", "$description": "3:1 against surface. Inputs, checkboxes." },
        "text":           { "$type": "color", "$value": "{primitive.color.slate.900}" },
        "textMuted":      { "$type": "color", "$value": "{primitive.color.slate.500}" },
        "heading":        { "$type": "color", "$value": "{primitive.color.navy.900}" },
        "action":         { "$type": "color", "$value": "{primitive.color.cobalt.700}" },
        "actionText":     { "$type": "color", "$value": "{primitive.color.cobalt.700}", "$description": "Links and outlined-button text. Equals action in light; lighter in dark for contrast." },
        "actionHover":    { "$type": "color", "$value": "{primitive.color.cobalt.800}" },
        "onAction":       { "$type": "color", "$value": "{primitive.color.slate.0}" },
        "actionSoft":     { "$type": "color", "$value": "{primitive.color.cobalt.100}" },
        "actionFaint":    { "$type": "color", "$value": "{primitive.color.cobalt.50}" },
        "focus":          { "$type": "color", "$value": "{primitive.color.cobalt.700}" },
        "danger":         { "$type": "color", "$value": "{primitive.color.red.600}" },
        "dangerText":     { "$type": "color", "$value": "{primitive.color.red.700}" },
        "dangerSoft":     { "$type": "color", "$value": "{primitive.color.red.100}" },
        "warning":        { "$type": "color", "$value": "{primitive.color.amber.700}" },
        "warningSoft":    { "$type": "color", "$value": "{primitive.color.amber.100}" },
        "success":        { "$type": "color", "$value": "{primitive.color.green.700}" },
        "successSoft":    { "$type": "color", "$value": "{primitive.color.green.100}" },
        "selection":      { "$type": "color", "$value": "{primitive.color.cobalt.100}" },
        "scrollThumb":    { "$type": "color", "$value": "{primitive.color.slate.400}" },
        "scrollTrack":    { "$type": "color", "$value": "{primitive.color.slate.100}" }
      },
      "shadow": {
        "popover": { "$type": "shadow", "$value": { "color": "rgba(20, 38, 58, 0.18)", "offsetX": "0px", "offsetY": "6px", "blur": "18px", "spread": "0px" } },
        "dialog":  { "$type": "shadow", "$value": { "color": "rgba(20, 38, 58, 0.28)", "offsetX": "0px", "offsetY": "14px", "blur": "40px", "spread": "0px" } }
      }
    },
    "dark": {
      "color": {
        "bar":            { "$type": "color", "$value": "{primitive.color.navy.950}" },
        "onBar":          { "$type": "color", "$value": "{primitive.color.night.100}" },
        "onBarMuted":     { "$type": "color", "$value": "{primitive.color.night.300}" },
        "ground":         { "$type": "color", "$value": "{primitive.color.night.900}" },
        "surface":        { "$type": "color", "$value": "{primitive.color.night.800}" },
        "surfaceSunken":  { "$type": "color", "$value": "{primitive.color.night.950}" },
        "surfaceBand":    { "$type": "color", "$value": "{primitive.color.night.700}" },
        "border":         { "$type": "color", "$value": "{primitive.color.night.600}" },
        "borderControl":  { "$type": "color", "$value": "{primitive.color.night.400}" },
        "text":           { "$type": "color", "$value": "{primitive.color.night.100}" },
        "textMuted":      { "$type": "color", "$value": "{primitive.color.night.300}" },
        "heading":        { "$type": "color", "$value": "{primitive.color.night.100}" },
        "action":         { "$type": "color", "$value": "{primitive.color.cobalt.500}" },
        "actionText":     { "$type": "color", "$value": "{primitive.color.cobalt.300}" },
        "actionHover":    { "$type": "color", "$value": "#5573FF" },
        "onAction":       { "$type": "color", "$value": "{primitive.color.slate.0}" },
        "actionSoft":     { "$type": "color", "$value": "#1E3159" },
        "actionFaint":    { "$type": "color", "$value": "#182A4A" },
        "focus":          { "$type": "color", "$value": "{primitive.color.cobalt.300}" },
        "danger":         { "$type": "color", "$value": "{primitive.color.red.300}" },
        "dangerText":     { "$type": "color", "$value": "{primitive.color.red.300}" },
        "dangerSoft":     { "$type": "color", "$value": "{primitive.color.red.900}" },
        "warning":        { "$type": "color", "$value": "{primitive.color.amber.300}" },
        "warningSoft":    { "$type": "color", "$value": "{primitive.color.amber.900}" },
        "success":        { "$type": "color", "$value": "{primitive.color.green.300}" },
        "successSoft":    { "$type": "color", "$value": "{primitive.color.green.900}" },
        "selection":      { "$type": "color", "$value": "#27427A" },
        "scrollThumb":    { "$type": "color", "$value": "{primitive.color.night.400}" },
        "scrollTrack":    { "$type": "color", "$value": "{primitive.color.night.800}" }
      },
      "shadow": {
        "popover": { "$type": "shadow", "$value": { "color": "rgba(0, 0, 0, 0.5)", "offsetX": "0px", "offsetY": "6px", "blur": "18px", "spread": "0px" } },
        "dialog":  { "$type": "shadow", "$value": { "color": "rgba(0, 0, 0, 0.6)", "offsetX": "0px", "offsetY": "14px", "blur": "40px", "spread": "0px" } }
      }
    }
  },
  "typography": {
    "$description": "Sizes are CSS px at 100% Windows scaling; the app scales with the system.",
    "fontWeight": {
      "light":    { "$type": "fontWeight", "$value": 300 },
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "scale": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "28px", "fontWeight": 300, "lineHeight": 1.2, "letterSpacing": "-0.01em" }, "$description": "Screen title. Navy, light weight." },
      "title":   { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "20px", "fontWeight": 400, "lineHeight": 1.3, "letterSpacing": "-0.005em" }, "$description": "Section and panel headings." },
      "heading": { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.35, "letterSpacing": "0" }, "$description": "Group headings, form section labels." },
      "body":    { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } },
      "table":   { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.35, "letterSpacing": "0" }, "$description": "Table cells. Numerals are tabular." },
      "label":   { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0.04em" }, "$description": "Column headers and status labels, uppercase." },
      "small":   { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0" }, "$description": "Help text, footers, timestamps." },
      "code":    { "$type": "typography", "$value": { "fontFamily": "{primitive.fontFamily.mono}", "fontSize": "12.5px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "Part numbers, tags, ordering codes, YAML." }
    }
  },
  "space": {
    "$description": "4 px base unit.",
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "24px" },
    "6":  { "$type": "dimension", "$value": "32px" },
    "7":  { "$type": "dimension", "$value": "48px" },
    "8":  { "$type": "dimension", "$value": "64px" }
  },
  "size": {
    "controlHeight":     { "$type": "dimension", "$value": "32px", "$description": "Buttons, inputs, selects." },
    "controlHeightCompact": { "$type": "dimension", "$value": "26px", "$description": "Inline controls inside table rows." },
    "rowHeight":         { "$type": "dimension", "$value": "28px", "$description": "Table body row, default density." },
    "rowHeightComfort":  { "$type": "dimension", "$value": "36px", "$description": "Table body row, comfortable density." },
    "targetMin":         { "$type": "dimension", "$value": "24px", "$description": "Smallest clickable target (WCAG 2.2 AA)." },
    "barHeight":         { "$type": "dimension", "$value": "48px" },
    "statusHeight":      { "$type": "dimension", "$value": "28px" },
    "navWidth":          { "$type": "dimension", "$value": "216px" },
    "contentMax":        { "$type": "dimension", "$value": "1280px" },
    "formMax":           { "$type": "dimension", "$value": "720px", "$description": "Widest form column (about 70 characters)." },
    "windowMin":         { "$type": "dimension", "$value": "1280px", "$description": "Minimum window width; minimum height is 720px." },
    "focusRing":         { "$type": "dimension", "$value": "2px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm":   { "$type": "dimension", "$value": "2px", "$description": "Buttons, inputs, tables, badges. Near-square, industrial." },
    "md":   { "$type": "dimension", "$value": "4px", "$description": "Dialogs, popovers." },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Round dots only (status dots, avatar)." }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "strong":   { "$type": "dimension", "$value": "2px", "$description": "Active tab underline, focus ring." }
  },
  "motion": {
    "duration": {
      "fast":   { "$type": "duration", "$value": "100ms" },
      "base":   { "$type": "duration", "$value": "160ms" },
      "slow":   { "$type": "duration", "$value": "240ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Exponential ease-out. All entrances." }
    },
    "$description": "Reduced-motion: durations drop to 0 and the only remaining change is the state itself."
  },
  "breakpoint": {
    "$description": "Desktop window widths the layout is designed for. Below 1280 the window will not shrink (minimum size).",
    "compact": { "$type": "dimension", "$value": "1280px" },
    "wide":    { "$type": "dimension", "$value": "1600px" }
  }
}
